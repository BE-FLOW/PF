# Optional for basic checks: without a key, PetFlow uses built-in safety rules.
# Required for AI veterinary summaries. Keep every OPENAI_* value server-only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_INPUT_COST_USD_PER_1M_TOKENS=0.75
OPENAI_OUTPUT_COST_USD_PER_1M_TOKENS=4.50

# RevenueCat verifies Apple, Google, and web purchases before credits are issued.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH_TOKEN=
REVENUECAT_AI_SUMMARY_PRODUCT_ID=petflow_ai_summary_1
# Browser-safe RevenueCat Billing key. Web checkout stays account-linked.
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=
NEXT_PUBLIC_REVENUECAT_AI_SUMMARY_PRODUCT_ID=petflow_ai_summary_1

# Server-only Supabase credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe Supabase credentials used for Auth and owner-only pet profiles.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional label shown in health checks when Vercel commit metadata is unavailable.
NEXT_PUBLIC_APP_VERSION=local
