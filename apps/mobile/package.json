{
  "name": "@petflow/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:release": "vitest run scripts/release-config.test.mjs",
    "verify": "npm run typecheck && npm test && npm run test:release && npm run expo:check && npm run doctor",
    "doctor": "npx expo-doctor",
    "expo:check": "expo install --check",
    "eas:whoami": "npx eas-cli whoami",
    "eas:init": "npx eas-cli init",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:android:production": "npx eas-cli build --platform android --profile production",
    "build:android:store-screenshot": "npx eas-cli build --platform android --profile store-screenshot",
    "build:ios:production": "npx eas-cli build --platform ios --profile production",
    "release:preflight:android": "node scripts/release-preflight.mjs --platform android",
    "release:preflight:ios": "node scripts/release-preflight.mjs --platform ios",
    "submit:android:closed": "npx eas-cli submit --platform android --profile closed --latest --non-interactive --wait",
    "submit:android:production": "npx eas-cli submit --platform android --profile production --latest --non-interactive --wait",
    "submit:ios:testflight-internal": "node scripts/distribute-ios-testflight.mjs --group \"PetFlow 내부 테스트\" --internal true",
    "submit:ios:testflight-external": "node scripts/distribute-ios-testflight.mjs --group \"PetFlow 보호자 테스트\" --internal false",
    "status:ios": "node scripts/ios-store-status.mjs",
    "readiness:ios:app-store": "node scripts/ios-release-readiness.mjs",
    "verify:ios:release-build": "node scripts/verify-ios-release-build.mjs",
    "stamp:android:screenshots": "node scripts/stamp-android-screenshots.mjs",
    "capture:android:screenshot": "node scripts/capture-android-store-screenshot.mjs",
    "generate:android:feature-graphic": "node scripts/generate-google-play-feature-graphic.mjs",
    "stamp:ios:screenshots": "node scripts/stamp-ios-screenshots.mjs",
    "prepare:ios:app-store": "node scripts/prepare-ios-app-store.mjs",
    "withdraw:ios:version": "node scripts/withdraw-ios-version.mjs",
    "validate:ios:screenshots": "node scripts/upload-ios-screenshots.mjs",
    "upload:ios:screenshots": "node scripts/upload-ios-screenshots.mjs --execute true",
    "release:android:closed": "npm run verify && npm run release:preflight:android && npm run submit:android:closed",
    "release:android:production": "npm run verify && npm run release:preflight:android && npm run submit:android:production",
    "release:ios:review-candidate": "npm run verify && npx eas-cli build --platform ios --profile production --auto-submit-with-profile production --non-interactive --wait"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~57.0.18",
    "expo-application": "~57.0.2",
    "expo-auth-session": "~57.0.10",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-image-picker": "~57.0.14",
    "expo-secure-store": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "nanoid": "3.3.18",
    "shell-quote": "1.10.0",
    "uuid": "^11.1.1"
  }
}
